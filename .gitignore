# Generated documents (rebuild with pandoc from the .md sources)
*.docx
*.pdf

# Local Chinese drafts - the English .md files are canonical in this repo
*.zh.md

# Course submission material: pitch slides, demo recordings, and the notes
# kept beside them. The deliverable is source and documentation; none of this
# is either, and the pitch deck alone is 11 MB. Both of these reached a commit
# on 2026-08-11 by being in the working tree when one was made, which is the
# whole reason this rule exists rather than a reminder to be careful.
*.pptx
*.ppt
*.mp4
*.mov
录像*

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Packaging output (pyproject.toml / setuptools). Anchored to the repository
# root so a future source directory called build/ is not swallowed too.
/build/
/dist/
.env
.env.*
!.env.example

# Test and coverage artifacts
.pytest_cache/
.coverage
htmlcov/

# Node (not used, kept as a guard)
node_modules/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.icloud
