# Copy to .env and fill in. .env is git-ignored.

# Signs session cookies AND derives the key that encrypts TOTP secrets.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# WARNING: changing this invalidates every enrolled authenticator. Run
#   python -m admin.cli rotate-key --old <old> --new <new>
# before restarting with a new value, or nobody will be able to log in.
SECRET_KEY=

# Matches docker-compose.yml
DATABASE_URL=mysql+pymysql://kaicalc:devpass@127.0.0.1:3307/kaicalc

# Minutes a staff session stays valid
SESSION_MAX_AGE_MINUTES=480

# Marks the session cookie Secure (browser will not send it over plain
# http). Defaults to true - leave unset in production, where TLS is
# terminated upstream: that is exactly the arrangement where a missing
# Secure flag lets one http:// navigation on the admin subdomain hand over
# the session. Set to false only for local development served over
# plain http.
SESSION_HTTPS_ONLY=true

# Login throttling: failures before lockout, and lockout duration.
# Password failures and TOTP failures share one counter.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# Where B's POST /api/v1/calculate lives. /admin/try and the pre-publish
# comparison view both call it. Defaults to a same-host loopback address -
# set this explicitly on any deployment that splits the API onto a
# separate host, or those two pages fail with "service not reachable" and
# nothing to point at.
API_BASE_URL=http://127.0.0.1:8000

# Whether the panel refuses blocked and scripted traffic (the blocklist, a
# header check, and a per-address rate limit - admin/protection.py).
# Defaults to true. THIS IS THE ESCAPE HATCH: set to false, with no
# redeploy, if a false positive locks staff out of their own panel and
# nobody can reach the CLI's `unblock` command fast enough. Turning it off
# also turns off the blocklist check - do not leave it off longer than the
# incident that made you flip it.
PROTECTION_ENABLED=true

# Requests per minute, per address, before the panel refuses further ones
# with 429. Counted in this process's own memory - running more than one
# worker multiplies the effective limit by the worker count. See
# admin/protection.py for the full reasoning.
PROTECTION_MAX_REQUESTS_PER_MINUTE=30

# Whether to trust the X-Forwarded-For header for the caller's address.
# WARNING: leave this false unless a reverse proxy that overwrites
# X-Forwarded-For itself genuinely sits in front of this panel. With no
# such proxy, X-Forwarded-For is a header any caller can set to any value -
# trusting it lets one visitor forge another's address, collapses the rate
# limit into one shared counter, and can make a single block deny everyone.
PROTECTION_TRUSTED_PROXY=false
