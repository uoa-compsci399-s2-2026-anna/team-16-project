# Copy to .env and fill in. .env is git-ignored.

# Signs session cookies AND derives the key that encrypts TOTP secrets.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# WARNING: changing this invalidates every enrolled authenticator. Run
#   python -m admin.cli rotate-key --old <old> --new <new>
# before restarting with a new value, or nobody will be able to log in.
# That command also CLEARS the IP blocklist and tells you how many rows it
# removed. A block is stored as an HMAC of the address under a key derived
# from this value, and an HMAC cannot be re-keyed - there is no plaintext
# address left to re-compute one from. Left in place the rows would survive
# the rotation matching nobody, and `unblock` could not remove them either.
# Re-apply any blocks that are still needed afterwards.
#
# The public API requires this too, and it must be the SAME value: both sides
# derive the blocklist fingerprint key from it independently, so two different
# secrets mean two different fingerprints for one address - a block made in the
# panel would simply never match at /api/v1/, with nothing raised on either
# side. api/app.py refuses to start without it for that reason.
SECRET_KEY=

# Matches docker-compose.yml
DATABASE_URL=mysql+pymysql://kaicalc:devpass@127.0.0.1:3307/kaicalc

# Minutes a staff session stays valid
SESSION_MAX_AGE_MINUTES=480

# Marks the session cookie Secure (browser will not send it over plain
# http). Defaults to true - leave unset in production, where TLS is
# terminated upstream: that is exactly the arrangement where a missing
# Secure flag lets one http:// navigation on the admin subdomain hand over
# the session. Set to false only for local development served over
# plain http.
SESSION_HTTPS_ONLY=true

# Login throttling: failures before lockout, and lockout duration.
# Password failures and TOTP failures share one counter.
#
# A locked account is refused even when the password is correct, and the
# login page says so - it names BOTH numbers from this file, so changing
# either one changes what a refused visitor is told ("After 5 failed
# attempts an account is locked for 15 minutes..."). It is a note under the
# refusal rather than part of it: stated at full weight, a rule about
# repeated attempts was read as a report that this attempt had locked the
# account. Nothing distinguishes a lockout from a wrong password in the
# response itself, on purpose: the same counter covers usernames that do not
# exist, so that the throttle cannot be used to find out which accounts are
# real.
#
# Operator's fastest way back, and deliberately NOT stated on the login page
# because an unauthenticated visitor can do nothing with it: the counters
# live in the admin process's own memory (admin/throttle.py), so
# `docker compose -f docker/compose.yaml restart admin` clears every lockout
# immediately. Restart, never `down -v` - that destroys the database and the
# credentials with it.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# Where B's POST /api/v1/calculate lives. /admin/try and the pre-publish
# comparison view both call it. Defaults to a same-host loopback address -
# set this explicitly on any deployment that splits the API onto a
# separate host, or those two pages fail with "service not reachable" and
# nothing to point at.
#
# 18000 is run.sh / run.ps1's default for `api` (KAICALC_API_PORT). Nothing in
# this system listens on 8000, which is what this line said until the API got
# a default port of its own - and 8000 is a port a developer machine very
# often has something else on, so the failure was "the wrong service answered"
# rather than "nothing answered".
#
# NOTE: admin/config.py's own fallback, used when this line is absent
# entirely, still reads http://127.0.0.1:8000 and is stale for the same
# reason. Set this explicitly rather than relying on it. A container
# deployment must set it to the API's SERVICE NAME, not to loopback -
# 127.0.0.1 inside the panel's container is the panel itself.
API_BASE_URL=http://127.0.0.1:18000

# Whether the panel refuses blocked and scripted traffic (the blocklist, a
# header check, and a per-address rate limit - admin/protection.py).
# Defaults to true.
#
# THIS IS THE ESCAPE HATCH. No code change and no rebuild - but a RESTART IS
# REQUIRED: every setting in this file is read once, at start-up, by
# load_settings(). Editing this line and waiting changes nothing, which is
# exactly the wrong thing to discover mid-incident. Edit, then restart.
#
# Turning it off turns off the blocklist check as well - do not leave it off
# longer than the incident that made you flip it.
#
# LOCKED OUT? Three paths, in the order to try them:
#   1. You know the exact address that is blocked:
#        python -m admin.cli unblock <address>
#      One command, no restart.
#   2. You do NOT know which address you blocked - the common case, because
#      nothing in this system ever displays one:
#        set PROTECTION_ENABLED=false -> restart -> log in ->
#        remove the block by row on /admin/ip-block/list (the screen's
#        unblock action needs no address, only the row) ->
#        set PROTECTION_ENABLED=true -> restart again.
#   3. No shell and no way to edit this file: against the database,
#        DELETE FROM ip_block;
#      That clears every block. ip_block has no foreign keys and nothing
#      references it, so nothing else breaks, and the panel is reachable on
#      the next request with no restart. It writes no audit entry, so note
#      what you did. Nothing else in this schema should be edited by hand.
#
# See docs/architecture.md 9.1.1 for the full version of all three.
PROTECTION_ENABLED=true

# Requests per minute, per address, before the panel refuses further ones
# with 429. Must be 1 or greater - the panel refuses to start on 0 or a
# negative value, because a limit of 0 refuses the FIRST unauthenticated
# request from every address, including on /admin/login, i.e. the page you
# would then need in order to fix it.
#
# /admin/login and /admin/verify are exempt from this limit (and from that
# check only - the blocklist and the header check still apply to them).
# Without that exemption, one request a second from any unauthenticated
# caller anywhere locked every administrator out remotely: behind a reverse
# proxy with PROTECTION_TRUSTED_PROXY false, every caller shares one
# counter. Login attempts are still throttled per account by
# LOGIN_MAX_FAILURES / LOGIN_LOCKOUT_MINUTES above.
#
# Counted in this process's own memory - running more than one worker
# multiplies the effective limit by the worker count. See
# admin/protection.py for the full reasoning.
PROTECTION_MAX_REQUESTS_PER_MINUTE=30

# Whether to trust the X-Forwarded-For header for the caller's address.
# WARNING: leave this false unless a reverse proxy that overwrites
# X-Forwarded-For itself genuinely sits in front of this panel. With no
# such proxy, X-Forwarded-For is a header any caller can set to any value -
# trusting it lets one visitor forge another's address, collapses the rate
# limit into one shared counter, and can make a single block deny everyone.
#
# Read by the public API as well as by the panel, on purpose: it states one
# fact about the deployment (is there a proxy in front?), and two switches for
# one fact is how they end up disagreeing. PROTECTION_ENABLED and
# PROTECTION_MAX_REQUESTS_PER_MINUTE above remain panel-only - the API's own
# limits are fixed by contract section 6.5.
PROTECTION_TRUSTED_PROXY=false

# ---------------------------------------------------------------------------
# WHERE THE FRONT END'S ORIGINS COME FROM (the kaicalc-web container only)
# ---------------------------------------------------------------------------
#
# NO DOMAIN IS BAKED INTO ANY IMAGE. docker/web-config.sh reads the three
# variables below once at container start and writes BOTH consumers from them:
# the `connect-src` and `img-src` of the public Content-Security-Policy in
# docker/nginx.conf, and web/js/config.js, the ES module the front end imports.
# One value each, two outputs, so the policy and the page cannot name different
# hosts.
#
# That is a fix rather than a refinement. The client's domain used to be written
# out twice - in web/js/api.js as the WordPress base, and in docker/nginx.conf
# as a connect-src entry - and the two had to agree while failing in opposite
# directions when they did not: a wrong policy means the news quietly does not
# load, and a wrong URL means the browser goes and asks a domain nobody chose.
# Neither raises anything. DNS, certificates and hosting are out of scope for
# this project, so the domain belongs here and in docker/compose.yaml, not in an
# artefact.
#
# A value that is not a bare scheme://host[:port] - a trailing slash, a path, a
# wildcard, a missing scheme - STOPS THE CONTAINER FROM STARTING. That is the
# correct failure: a typo must not become a policy nobody meant, and the same
# check is what makes the value safe to interpolate into an HTTP header and into
# a JavaScript string literal.

# The client's WordPress site. docker/compose.yaml defaults it to
# https://kaicommitment.org.nz; SET IT EMPTY AND THE HOME PAGE REMOVES ITS NEWS
# SECTION ENTIRELY, which is a supported deployment and not a degraded one -
# most installations of this calculator have no WordPress behind them. An unset
# origin is not an error to report to a reader, and it is never a host to guess.
KAICALC_NEWS_ORIGIN=https://kaicommitment.org.nz

# WHERE THE FRONT END FINDS THE PUBLIC API. LEAVE IT EMPTY UNLESS YOU MEAN IT.
#
# Empty means web/js/api.js builds `/api/v1`, a relative path resolved against
# whatever origin served the page, and nginx routes it on. Same-origin is the
# designed topology: no CORS, no preflight, no configuration.
#
# It is settable because the alternative was the same two-copies defect one
# layer up. Split the API onto its own subdomain without it and the path in
# api.js and the connect-src in nginx.conf both have to change, or every call is
# refused by our own policy with nothing in the failure pointing at nginx.
#
# WEIGH IT AS YOU WOULD THE NGINX CONFIGURATION ITSELF. This is the front end of
# a tool whose numbers are the product, and pointing it at an API the client does
# not control puts the client's branding over somebody else's arithmetic. Three
# things hold that line: the value is read from this environment and from nowhere
# a visitor can reach - never a query parameter, never sessionStorage; a
# malformed value stops the container rather than reaching the page; and
# connect-src is generated from this same string, so the browser can reach the
# one origin named here and no other.
KAICALC_API_ORIGIN=

# img-src only, space-separated. For a WordPress media library that serves from
# a CDN (i0.wp.com and friends when Jetpack is on) rather than from the site
# origin. A separate variable because it is a separate permission: a host that
# may serve images must not thereby become a host the page may fetch() from.
# See the note on `createNewsCard` in web/js/home.js.
KAICALC_NEWS_IMAGE_ORIGINS=
